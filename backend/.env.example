# ============================================
# BeCool Market - .env 配置模板
# ============================================
# 复制此文件为 .env 并填写你的远程 MySQL 信息
#
# DATABASE_URL=mysql+pymysql://用户名:密码@主机:端口/数据库名
# 示例: mysql+pymysql://root:123456@1.2.3.4:3306/eshshop

DATABASE_URL=mysql+pymysql://root:your_password@your-server-ip:3306/eshshop
SECRET_KEY=becool-market-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5175
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
STOCK_RESERVATION_MINUTES=30
PRICES_INCLUDE_TAX=true
DEFAULT_TAX_RATE=0.19
# Optional destination VAT overrides as ISO code:rate pairs.
TAX_RATES=CY:0.19,DE:0.19,FR:0.20,IT:0.22,ES:0.21,GR:0.24,NL:0.21,BE:0.21,AT:0.20,PT:0.23,IE:0.23,LU:0.17,MT:0.18
CORS_ORIGINS=https://shop.example.com
